# Twilio sandbox (M3) — copy to .env and fill real sandbox values locally.
# NEVER commit a filled .env. When all four are set, the API sends through the
# Twilio sandbox; otherwise it uses log-only sandbox providers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Web push (contracts v1.10) — VAPID keypair for real browser/OS push delivery.
# Generate once per environment: npx web-push generate-vapid-keys
# When unset, the API uses a log-only sandbox push provider (no external calls).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@contake.app

# Pilot deploy: suppress devCode in /v1/auth/otp/request responses (mandatory in pilot).
CONTAKE_DEV_OTP=false
# Super Admin phone allowlist (server-side authority for profile-switch
# testing). FAIL CLOSED: unset/empty means NO Super Admin exists - there is
# no hardcoded or default privileged phone in the code (QA stop-ship
# 2026-09-17). Comma-separated strict E.164 entries; parsing is FAIL-LOUD
# (a malformed entry aborts boot; exact duplicates are deduped).
# Approved real values live ONLY in the ops configuration record - never
# commit real phone numbers to this repository (QA lifecycle gate).
CONTAKE_SUPER_ADMIN_PHONES=
